#!/usr/bin/env python3
"""找出当前生效的风格文件并打印。只用 Python 标准库。

    wikipali-style [名字]            # 打印生效的那份（默认 translation），首行注明来源
    wikipali-style [名字] --json     # {"name","level","path","settings","body"}
    wikipali-style [名字] --path     # 只打印路径
    wikipali-style init [名字]       # 把插件默认复制到 ./.wikipali/styles/<名字>.md
    wikipali-style init [名字] --user  # 复制到 ~/.wikipali/styles/<名字>.md

查找顺序，找到第一份就用它（项目与个人之间不合并）：

    1. 项目：从当前目录往上找 .wikipali/styles/<名字>.md（不含家目录）
    2. 个人：~/.wikipali/styles/<名字>.md
    3. 插件默认：本插件 references/ 下的对应文件

文件开头可以有 frontmatter（--- 包起来的 key: value），放开关类设置，如 nissaya: true。
生效文件里没写的设置项取插件默认文件里的值；正文同理，没写到的事项由 skill 按插件默认处理。

只读 styles/ 下的文件；同一目录里的 credentials.json 等一概不碰。
"""

import json
import os
import re
import shutil
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
DEFAULTS = {
    'translation': os.path.join(ROOT, 'references', 'translation-style.md'),
}
NAME_RE = re.compile(r'^[a-z0-9][a-z0-9-]{0,40}$')


def fail(msg, code=1):
    print(f'wikipali-style：{msg}', file=sys.stderr)
    sys.exit(code)


def check_name(name):
    if not NAME_RE.match(name):
        fail(f'名字 {name!r} 不合法：只能用小写字母、数字和 -')
    if name not in DEFAULTS:
        fail(f'没有 {name!r} 这种风格，可选：{", ".join(sorted(DEFAULTS))}')


def candidates(name):
    """按优先级给出 (层级, 路径)。"""
    home = os.path.realpath(os.path.expanduser('~'))
    rel = os.path.join('.wikipali', 'styles', f'{name}.md')
    d = os.path.realpath(os.getcwd())
    while True:
        if d != home:
            yield 'project', os.path.join(d, rel)
        parent = os.path.dirname(d)
        if parent == d:
            break
        d = parent
    yield 'user', os.path.join(home, rel)
    yield 'default', DEFAULTS[name]


def parse(text):
    """拆出 frontmatter（简单的 key: value）与正文。"""
    settings = {}
    m = re.match(r'---\r?\n(.*?)\r?\n---\r?\n?', text, re.S)
    if not m:
        return settings, text
    for line in m.group(1).splitlines():
        line = line.strip()
        if not line or line.startswith('#') or ':' not in line:
            continue
        key, val = (s.strip() for s in line.split(':', 1))
        low = val.lower()
        settings[key] = True if low == 'true' else False if low == 'false' else val
    return settings, text[m.end():]


def read(path):
    with open(path, encoding='utf-8') as fh:
        return fh.read()


def resolve(name):
    for level, path in candidates(name):
        if os.path.isfile(path):
            return level, path
    fail(f'插件默认文件缺失：{DEFAULTS[name]}。插件副本不完整，重装一下')


def cmd_show(name, as_json, path_only):
    level, path = resolve(name)
    if path_only:
        print(path)
        return
    default_settings, _ = parse(read(DEFAULTS[name]))
    settings, body = parse(read(path))
    merged = {**default_settings, **settings}
    if as_json:
        json.dump({'name': name, 'level': level, 'path': path, 'settings': merged, 'body': body},
                  sys.stdout, ensure_ascii=False, indent=2)
        print()
        return
    label = {'project': '项目', 'user': '个人', 'default': '插件默认'}[level]
    print(f'<!-- 生效的 {name} 风格：{label} {path} -->')
    if merged:
        print('<!-- 设置：' + '，'.join(f'{k}={str(v).lower() if isinstance(v, bool) else v}'
                                      for k, v in merged.items()) + ' -->')
    sys.stdout.write(body)


def cmd_init(name, user):
    base = os.path.expanduser('~') if user else os.getcwd()
    dest = os.path.join(base, '.wikipali', 'styles', f'{name}.md')
    if os.path.exists(dest):
        fail(f'{dest} 已存在，不覆盖')
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    shutil.copyfile(DEFAULTS[name], dest)
    print(f'已建立 {dest}（复制自插件默认），按需修改')


def main(argv):
    flags = {a for a in argv if a.startswith('-')}
    args = [a for a in argv if not a.startswith('-')]
    unknown = flags - {'--json', '--path', '--user', '-h', '--help'}
    if unknown:
        fail(f'不认识的参数：{" ".join(sorted(unknown))}', 2)
    if flags & {'-h', '--help'}:
        print(__doc__.strip())
        return
    if args and args[0] == 'init':
        name = args[1] if len(args) > 1 else 'translation'
        check_name(name)
        cmd_init(name, '--user' in flags)
        return
    if len(args) > 1:
        fail('只接受一个名字', 2)
    name = args[0] if args else 'translation'
    check_name(name)
    cmd_show(name, '--json' in flags, '--path' in flags)


if __name__ == '__main__':
    main(sys.argv[1:])
